# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env*` files (covered by .gitignore) — only `.env.example` is allowed.

# GitHub personal access token — for pushing to the repo
# Generate at https://github.com/settings/tokens (needs `repo` scope)
github_key=github_pat_xxx

# MiniMax image generation API key — for generating UI style images via the
# image-01 model. See https://platform.minimaxi.com/docs/guides/image-generation
minimaxi_api_key=sk-cp-xxx

# iFlytek IAT (speech-to-text for UR2.3) — get from https://console.xfyun.cn
# IFLYTEK_APP_ID=xxx
# IFLYTEK_API_KEY=xxx
# IFLYTEK_API_SECRET=xxx

# OpenAI moderation (UR E.2 发送工作流审核：免费，见 Help Center
# "Is the Moderation endpoint free to use"；key 在 https://platform.openai.com/api-keys 取，
# 只活服务端）.缺席即跳过审核（仅开发态容许），生产必须配。
# OPENAI_API_KEY=sk-xxx
# （兼容舊名 OPENAI_KEY；代碼優先讀 OPENAI_API_KEY）

# MiniMax 兜底审核（UR E.2：chat 回包 input_sensitive 平台信号；走 token 计费；
# key 已有 minimaxi_api_key；基址默认 CN 域，需切全球版再配此项）。
# MINIMAX_API_BASE=https://api.minimax.io

# Supabase — fill in after creating a project at https://supabase.com
# (region: Singapore or Tokyo recommended for HK proximity)
# New key scheme (default on 2025+ projects): publishable + secret.
# Legacy scheme also works: anon key + service_role key.
# Fill ONE pair; the app prefers the new scheme and falls back to legacy.
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API — for AI mood/food recommendations (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxx

# Google Places API — for local bar discovery
# GOOGLE_PLACES_API_KEY=xxx

# Stadia Maps watercolor basemap — DORMANT (UR1.1 currently uses keyless OSM).
# Re-activate by wiring lib/geo.ts stadiaTileUrl back in as the primary layer.
# Free key from https://client.stadiamaps.com (dashboard -> API key).
# NEXT_PUBLIC_STADIA_KEY=xxx

# Stitch (Google Labs) API key — for Stitch MCP design access in Muse Code.
# Configure in ~/.config/muse/settings.json -> mcp_servers.stitch
# (streamable_http, https://stitch.googleapis.com/mcp, header X-Goog-Api-Key).
# See .memory/2026-09-04-stitch-mcp-setup.md for the merge command.
# STITCH_API_KEY=xxx

# 首頁版本（UR C.7）：v2＝裸 `/` 跳 `/v2`，v1＝`/` 走舊 v1 首頁。
# 缺省 v2；帶查詢串的 v1 深鏈（/?pick=1）永遠直通不劫持。
# 注意：proxy 的 env 編譯期烘焙——Vercel 改此值後需 redeploy 才生效。
# HOME_UI=v2

# 地圖底圖試水（UR C.8，v2 only）：osm＝OSM（缺省，與之前一致）／amap＝高德標準瓦片。
# 回退＝改回 osm 重啟 dev／重部署；高德瓦片連續失敗會自動回 OSM。
# 注意：直拼瓦片屬試水（ToS 灰色）；轉正走官方 JS API（Phase 2，需 Key，另開 UR）。
# NEXT_PUBLIC_MAP_PROVIDER=osm

# 高德 Web 服务 Key（UR G.4 附近页＋F.1 地点搜索，console.amap.com 建 Web 服务 key；
# 服务端专用，切勿加 NEXT_PUBLIC_ 前缀；Vercel 后台同步加 AMAP_KEY 并重部署）。
# AMAP_KEY=
