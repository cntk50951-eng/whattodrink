# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env*` files (covered by .gitignore) — only `.env.example` is allowed.

# GitHub personal access token — for pushing to the repo
# Generate at https://github.com/settings/tokens (needs `repo` scope)
github_key=github_pat_xxx

# MiniMax image generation API key — for generating UI style images via the
# image-01 model. See https://platform.minimaxi.com/docs/guides/image-generation
minimaxi_api_key=sk-cp-xxx

# Supabase — fill in after creating a project at https://supabase.com
# (region: Singapore or Tokyo recommended for HK proximity)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API — for AI mood/food recommendations (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxx

# Google Places API — for local bar discovery
# GOOGLE_PLACES_API_KEY=xxx
